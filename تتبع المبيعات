# ==========================================
#        مشروع نظام تتبع المبيعات    
# ==========================================

مبيعات_المنتجات = {
    "كاميرا": [900, 1100, 1400, 1600],
    "جهاز لوحي": [800, 1200, 1000, 1500]
}

# نستخدم Set لتخزين الفئات بدون تكرار
فئات_المنتجات = {"تصوير", "أجهزة لوحية", "ملحقات"}


# هذه الدالة تضيف منتجًا جديدًا بقائمة مبيعات فارغة
def إضافة_منتج():
    اسم_المنتج = input("أدخل اسم المنتج الجديد: ")

    if اسم_المنتج in مبيعات_المنتجات:
        print("المنتج موجود مسبقًا")
    else:
        مبيعات_المنتجات[اسم_المنتج] = []
        print("تمت إضافة المنتج بنجاح")


# هذه الدالة تسجل مبيعات شهر جديد لمنتج موجود
def إضافة_مبيعات_شهرية():
    اسم_المنتج = input("أدخل اسم المنتج: ")

    if اسم_المنتج in مبيعات_المنتجات:
        قيمة_المبيعات = float(input("أدخل قيمة المبيعات للشهر الجديد: "))
        مبيعات_المنتجات[اسم_المنتج].append(قيمة_المبيعات)
        print("تم تسجيل المبيعات بنجاح")
    else:
        print("المنتج غير موجود")


# هذه الدالة تعرض كل المنتجات ومبيعاتها الشهرية بشكل منسق
def عرض_المبيعات():
    if len(مبيعات_المنتجات) == 0:
        print("لا توجد منتجات")
        return

    print("\n{:<20} {}".format("المنتج", "المبيعات الشهرية"))
    print("-" * 50)

    for اسم_المنتج, قائمة_المبيعات in مبيعات_المنتجات.items():
        print("{:<20} {}".format(اسم_المنتج, قائمة_المبيعات))


# هذه الدالة تحسب إجمالي مبيعات منتج معين
def حساب_إجمالي_المبيعات():
    اسم_المنتج = input("أدخل اسم المنتج: ")

    if اسم_المنتج in مبيعات_المنتجات:
        الإجمالي = sum(مبيعات_المنتجات[اسم_المنتج])
        print(f"إجمالي مبيعات {اسم_المنتج}: {الإجمالي:.2f}")
    else:
        print("المنتج غير موجود")


# هذه الدالة تحسب متوسط المبيعات الشهرية لمنتج معين
def حساب_متوسط_المبيعات():
    اسم_المنتج = input("أدخل اسم المنتج: ")

    if اسم_المنتج not in مبيعات_المنتجات:
        print("المنتج غير موجود")
    elif len(مبيعات_المنتجات[اسم_المنتج]) == 0:
        print("لا توجد مبيعات مسجلة لهذا المنتج")
    else:
        المتوسط = sum(مبيعات_المنتجات[اسم_المنتج]) / len(مبيعات_المنتجات[اسم_المنتج])
        print(f"متوسط مبيعات {اسم_المنتج}: {المتوسط:.2f}")


# هذه الدالة تعرض المنتج الأعلى مبيعًا حسب الإجمالي
def إيجاد_المنتج_الأعلى():
    if len(مبيعات_المنتجات) == 0:
        print("لا توجد منتجات")
        return

    اسم_الأعلى = ""
    أعلى_إجمالي = -1

    for اسم_المنتج, قائمة_المبيعات in مبيعات_المنتجات.items():
        الإجمالي = sum(قائمة_المبيعات)

        if الإجمالي > أعلى_إجمالي:
            أعلى_إجمالي = الإجمالي
            اسم_الأعلى = اسم_المنتج

    print(f"المنتج الأعلى مبيعًا: {اسم_الأعلى}")
    print(f"إجمالي المبيعات: {أعلى_إجمالي:.2f}")


# هذه الدالة تعرض القائمة الرئيسية للبرنامج
def عرض_القائمة():
    print("\n=== نظام تتبّع المبيعات ===")
    print("1. إضافة منتج جديد")
    print("2. تسجيل مبيعات شهر جديد")
    print("3. عرض كل المنتجات ومبيعاتهم")
    print("4. حساب إجمالي مبيعات منتج")
    print("5. حساب متوسط مبيعات منتج")
    print("6. عرض المنتج الأعلى مبيعًا")
    print("7. خروج")


# الحلقة الرئيسية لتشغيل البرنامج
while True:
    عرض_القائمة()
    الاختيار = input("اختر رقم العملية: ")

    if الاختيار == "1":
        إضافة_منتج()
    elif الاختيار == "2":
        إضافة_مبيعات_شهرية()
    elif الاختيار == "3":
        عرض_المبيعات()
    elif الاختيار == "4":
        حساب_إجمالي_المبيعات()
    elif الاختيار == "5":
        حساب_متوسط_المبيعات()
    elif الاختيار == "6":
        إيجاد_المنتج_الأعلى()
    elif الاختيار == "7":
        print("تم الخروج من نظام تتبع المبيعات")
        break
    else:
        print("اختيار غير صحيح، حاول مرة أخرى")
