# هذه الدالة تحسب الإيراد من السعر والكمية
def حساب_الإيراد(السعر, الكمية):
    return السعر * الكمية


# هذه الدالة تحسب السعر بعد تطبيق الخصم
def تطبيق_الخصم(السعر, نسبة_الخصم=10):
    قيمة_الخصم = السعر * (نسبة_الخصم / 100)
    return السعر - قيمة_الخصم


# هذه الدالة تصنف الأداء حسب قيمة المبيعات
def تصنيف_الأداء(قيمة_المبيعات):
    if قيمة_المبيعات < 1000:
        return "ضعيف"
    elif قيمة_المبيعات <= 5000:
        return "متوسط"
    else:
        return "ممتاز"


# هذه الدالة تحسب متوسط قائمة أرقام
def حساب_المتوسط(قائمة_الأرقام):
    return sum(قائمة_الأرقام) / len(قائمة_الأرقام)


print("الإيراد:", حساب_الإيراد(500, 8))
print("السعر بعد الخصم:", تطبيق_الخصم(1000))
print("تصنيف الأداء:", تصنيف_الأداء(6000))
print("المتوسط:", حساب_المتوسط([100, 200, 300]))


